{
  "info": {
    "_postman_id": "sidinei-qa-jsonplaceholder",
    "name": "QA Portfolio - JSONPlaceholder API Tests",
    "description": "Collection de testes de API para portfólio QA de Sidinei Schaedler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-001 - GET post existente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Resposta deve conter campos esperados', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json).to.have.property('userId');",
              "  pm.expect(json).to.have.property('title');",
              "  pm.expect(json).to.have.property('body');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-002 - GET post inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/999999",
          "host": ["{{base_url}}"],
          "path": ["posts", "999999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code deve ser 404 ou 200 conforme comportamento da API pública', function () {",
              "  pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-003 - POST criar post simulado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Teste QA Sidinei\",\n  \"body\": \"Criando post simulado para validação de API.\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": ["{{base_url}}"],
          "path": ["posts"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code deve ser 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Resposta deve conter id', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-004 - PUT atualizar post simulado",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Teste QA atualizado\",\n  \"body\": \"Atualização simulada via PUT.\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Título deve ser atualizado na resposta', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.title).to.eql('Teste QA atualizado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "API-005 - DELETE post simulado",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/1",
          "host": ["{{base_url}}"],
          "path": ["posts", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code deve indicar remoção aceita', function () {",
              "  pm.expect([200, 204]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
